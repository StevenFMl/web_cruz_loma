---
interface Props {
  numeral: string;
  label: string;
  caption: string;
}
const { numeral, label, caption } = Astro.props;
---

<header class="chapter-mark">
  <span class="chapter-mark__numeral" aria-hidden="true">{numeral}</span>

  <div class="chapter-mark__meta">
    <span class="chapter-mark__label">Capítulo · {numeral}</span>
    <h2 class="chapter-mark__title">{label}</h2>
    <p class="chapter-mark__caption">{caption}</p>
  </div>
</header>

<style>
  .chapter-mark {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 3.5rem 1.25rem 1.25rem;
    max-width: 110rem;
    margin: 0 auto;
    border-bottom: 2px solid var(--color-copper);
  }
  @media (min-width: 640px) {
    .chapter-mark { gap: 2rem; padding: 4rem 1.5rem 1.5rem; }
  }
  @media (min-width: 768px) {
    .chapter-mark { padding: 6rem 3rem 2rem; }
  }
  @media (min-width: 1024px) {
    .chapter-mark { padding: 7rem 5rem 2.5rem; }
  }

  .chapter-mark__numeral {
    font-family: var(--font-display);
    font-size: clamp(5rem, 20vw, 18rem);
    line-height: 0.8;
    color: rgb(236 102 8 / 0.22);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    flex-shrink: 0;
    transform: translateY(0.3em);
    user-select: none;
  }

  .chapter-mark__meta { text-align: right; margin-bottom: 1rem; }

  .chapter-mark__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--color-copper);
    margin-bottom: 0.75rem;
  }

  .chapter-mark__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    color: var(--color-bone);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin-bottom: 0.5rem;
  }

  .chapter-mark__caption {
    font-family: var(--font-cond);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(243 235 217 / 0.7);
    font-size: clamp(0.875rem, 1.4vw, 1.25rem);
    line-height: 1.25;
    max-width: 28ch;
    margin-left: auto;
    overflow-wrap: break-word;
  }
</style>
