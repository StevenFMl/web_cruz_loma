---
interface Props {
  numeral: string;
  label: string;
  caption: string;
}
const { numeral, label, caption } = Astro.props;
---

<header class="chapter-mark">
  <span class="chapter-mark__numeral" aria-hidden="true">{numeral}</span>

  <div class="chapter-mark__meta">
    <span class="chapter-mark__label">Capítulo · {numeral}</span>
    <h2 class="chapter-mark__title">{label}</h2>
    <p class="chapter-mark__caption">{caption}</p>
  </div>
</header>

<style>
  .chapter-mark {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 4rem 1.5rem 1.5rem;
    max-width: 110rem;
    margin: 0 auto;
    border-bottom: 1px solid rgb(39 39 42 / 0.8);
  }
  @media (min-width: 768px) {
    .chapter-mark { padding: 6rem 3rem 2rem; }
  }
  @media (min-width: 1024px) {
    .chapter-mark { padding: 7rem 5rem 2.5rem; }
  }

  .chapter-mark__numeral {
    font-family: var(--font-editorial);
    font-style: italic;
    font-variation-settings: "opsz" 144, "SOFT" 100;
    font-size: clamp(6rem, 18vw, 16rem);
    line-height: 0.8;
    color: rgb(184 115 51 / 0.18);
    letter-spacing: -0.04em;
    flex-shrink: 0;
    transform: translateY(0.3em);
    user-select: none;
  }

  .chapter-mark__meta { text-align: right; margin-bottom: 1rem; }

  .chapter-mark__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: rgb(184 115 51);
    margin-bottom: 0.75rem;
  }

  .chapter-mark__title {
    font-family: var(--font-slab);
    font-weight: 900;
    font-size: clamp(1.75rem, 3vw, 3rem);
    color: rgb(231 229 228);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .chapter-mark__caption {
    font-family: var(--font-editorial);
    font-style: italic;
    color: rgb(231 229 228 / 0.7);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.2;
    max-width: 28ch;
    margin-left: auto;
  }
</style>
