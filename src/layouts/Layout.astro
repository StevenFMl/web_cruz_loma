---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cruz Loma — Cervecería artesanal premium, elaborada en la Mitad del Mundo." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a1512" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Tipografía editorial:
         — Cormorant Garamond: titular display (serif elegante, alta gama)
         — Inter: cuerpo y UI (sans neutro)
         — Pacifico: acento manuscrito ocasional ("Ganache")
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&family=Pacifico&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body
    class="bg-[#1a1512] font-sans text-[#d9cdb6] antialiased overflow-x-hidden"
  >
    <slot />
  </body>
</html>

<style is:global>
  /* =================================================================
     FAMILIAS TIPOGRÁFICAS
     ================================================================= */
  :root {
    --font-display: "Cormorant Garamond", "Source Serif 4", Georgia, serif;
    --font-sans: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-script: "Pacifico", cursive;
  }

  body {
    font-family: var(--font-sans);
  }

  /* Display serif — para titulares editoriales imponentes */
  .font-display {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  /* Display ligero, en cursiva — variante refinada */
  .font-display-italic {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* Sans para UI, etiquetas, botones */
  .font-sans {
    font-family: var(--font-sans);
  }

  /* Script — sólo para acentos ornamentales puntuales */
  .font-script {
    font-family: var(--font-script);
  }

  /* Aliases conservados (compatibilidad con clases previas) */
  .font-ganache { font-family: var(--font-display); font-weight: 500; }
  .font-gotham  { font-family: var(--font-sans); font-weight: 600; }
  .font-source  { font-family: var(--font-display); }
  .font-vintage { font-family: var(--font-display); font-weight: 500; }
</style>
