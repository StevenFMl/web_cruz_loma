---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cruz Loma — Cervecería artesanal de la Mitad del Mundo. Ámbar, lúpulo y oficio." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a1410" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Tipografía Brewery / Rustic-Elegant:
         — Alfa Slab One: titular monumental tipo "letrero de cervecería"
         — Zilla Slab: slab serif general (h2/h3, énfasis), peso visual sólido
         — Barlow Condensed: condensed sans para etiquetas/UI estilo barril
         — Barlow: cuerpo de texto cómodo
         — Space Mono: datos técnicos (ABV, IBU, lote, OG) — voz del maestro cervecero
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Zilla+Slab:wght@500;600;700;800&family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body
    class="bg-[#1a1410] font-sans text-[#d4c5a8] antialiased overflow-x-hidden"
  >
    <slot />
  </body>
</html>

<style is:global>
  /* =================================================================
     FAMILIAS — slab brewery + condensed labels + technical mono
     ================================================================= */
  :root {
    --font-display: "Alfa Slab One", "Zilla Slab", Georgia, serif;
    --font-slab: "Zilla Slab", "Roboto Slab", Georgia, serif;
    --font-condensed: "Barlow Condensed", "Oswald", "Impact", sans-serif;
    --font-sans: "Barlow", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-mono: "Space Mono", "IBM Plex Mono", ui-monospace, monospace;
  }

  body {
    font-family: var(--font-sans);
    font-weight: 400;
  }

  /* Display monumental — el "letrero del barril" */
  .font-display {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.005em;
  }

  /* Slab — para titulares secundarios, énfasis con cuerpo */
  .font-slab {
    font-family: var(--font-slab);
    font-weight: 700;
  }
  .font-slab-bold {
    font-family: var(--font-slab);
    font-weight: 800;
  }

  /* Condensed — etiquetas, UI, eyebrows */
  .font-condensed {
    font-family: var(--font-condensed);
    font-weight: 600;
  }

  /* Mono — datos técnicos */
  .font-mono {
    font-family: var(--font-mono);
  }

  /* Aliases retrocompatibles — apuntan al nuevo lenguaje */
  .font-vintage  { font-family: var(--font-slab); font-weight: 700; }
  .font-ganache  { font-family: var(--font-slab); font-weight: 700; }
  .font-gotham   { font-family: var(--font-condensed); font-weight: 700; }
  .font-source   { font-family: var(--font-sans); }
  .font-script   { font-family: var(--font-slab); font-weight: 700; font-style: italic; }
  .font-display-italic { font-family: var(--font-slab); font-weight: 700; font-style: italic; }
</style>
