---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cruz Loma — Cervecería artesanal de la Mitad del Mundo. Ámbar, lúpulo y oficio." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a1410" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!--
      SISTEMA TIPOGRÁFICO OFICIAL CRUZ LOMA
      ─────────────────────────────────────
      • GANACHE          — Titulares principales (display, nombres de cervezas).
                           Fuente comercial con licencia. Si está disponible localmente
                           (ver public/fonts/ganache.woff2), se usa primero.
                           Fallback open-source: Alfa Slab One (slab impacto).

      • GOTHAM BOLD      — Énfasis, navegación, botones, etiquetas.
                           Fuente comercial con licencia.
                           Fallback open-source: Montserrat 700/800.

      • SOURCE SERIF     — Cuerpo de texto, narrativa, descripciones.
                           Variable Font open-source vía Google Fonts.

      • SPACE MONO       — Datos técnicos de laboratorio cervecero (ABV, IBU, OG).
    -->

    <!-- Fallbacks open-source vía Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Montserrat:wght@500;600;700;800;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..800;1,8..60,300..700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!--
      Carga local condicional para fuentes comerciales licenciadas.
      Coloca los archivos en /public/fonts/ y se cargarán automáticamente.
      Si no existen, el navegador hace fallback transparente a Google Fonts.
      `is:inline` evita que Vite intente resolver las URLs en build time.
    -->
    <style is:inline>
      /* GANACHE — drop-in si /public/fonts/Ganache.woff2 existe */
      @font-face {
        font-family: 'Ganache';
        src: local('Ganache'),
             url('/fonts/Ganache.woff2') format('woff2'),
             url('/fonts/Ganache.woff')  format('woff');
        font-weight: 400 800;
        font-style: normal;
        font-display: swap;
      }

      /* GOTHAM BOLD — drop-in si /public/fonts/Gotham-Bold.woff2 existe */
      @font-face {
        font-family: 'Gotham';
        src: local('Gotham Bold'), local('Gotham-Bold'),
             url('/fonts/Gotham-Bold.woff2') format('woff2'),
             url('/fonts/Gotham-Bold.woff')  format('woff');
        font-weight: 700 900;
        font-style: normal;
        font-display: swap;
      }

      /* SOURCE SERIF VARIABLE — drop-in del archivo variable */
      @font-face {
        font-family: 'Source Serif Variable';
        src: local('Source Serif Variable'),
             url('/fonts/SourceSerif4-VariableFont.ttf') format('truetype-variations'),
             url('/fonts/SourceSerif4-Variable.woff2')   format('woff2-variations');
        font-weight: 200 900;
        font-style: normal;
        font-display: swap;
      }
    </style>

    <title>{title}</title>
  </head>
  <body
    class="font-source bg-[#1a1410] text-[#d4c5a8] antialiased overflow-x-hidden"
  >
    <slot />
  </body>
</html>

<style is:global>
  /* =================================================================
     VARIABLES TIPOGRÁFICAS — encadenadas con fallbacks
     ================================================================= */
  :root {
    /* Display: nombres de cervezas, titulares imponentes */
    --font-display: "Ganache", "Alfa Slab One", "Bowlby One", Georgia, serif;

    /* Énfasis: CTAs, etiquetas, navegación */
    --font-emphasis: "Gotham", "Gotham Bold", "Montserrat", system-ui, sans-serif;

    /* Cuerpo: descripciones y narrativa */
    --font-body: "Source Serif Variable", "Source Serif 4", "Source Serif Pro", Georgia, "Times New Roman", serif;

    /* Mono — sellos de laboratorio cervecero */
    --font-mono: "Space Mono", "IBM Plex Mono", ui-monospace, "Courier New", monospace;
  }

  body {
    font-family: var(--font-body);
    font-weight: 400;
  }

  /* =================================================================
     CLASES UTILITARIAS — nombre semántico = nombre de fuente oficial
     ================================================================= */

  /* GANACHE — display */
  .font-ganache,
  .font-display {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.005em;
  }

  /* GOTHAM BOLD — UI / emphasis */
  .font-gotham,
  .font-emphasis,
  .font-condensed {
    font-family: var(--font-emphasis);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .font-gotham-black {
    font-family: var(--font-emphasis);
    font-weight: 900;
  }

  /* SOURCE SERIF — body */
  .font-source,
  .font-body {
    font-family: var(--font-body);
    font-weight: 400;
  }

  /* SPACE MONO — datos técnicos */
  .font-mono,
  .font-tech {
    font-family: var(--font-mono);
  }

  /* Aliases retrocompatibles */
  .font-vintage         { font-family: var(--font-display); font-weight: 400; }
  .font-slab            { font-family: var(--font-display); font-weight: 400; }
  .font-slab-bold       { font-family: var(--font-display); font-weight: 400; }
  .font-script          { font-family: var(--font-display); font-weight: 400; font-style: italic; }
  .font-display-italic  { font-family: var(--font-body); font-weight: 500; font-style: italic; }
  .font-sans            { font-family: var(--font-emphasis); font-weight: 600; }
</style>
